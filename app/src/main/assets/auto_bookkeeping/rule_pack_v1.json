{
  "schema_version": 1,
  "pack_id": "builtin.cn.payment",
  "pack_version": 3,
  "rules": [
    {
      "id": "wechat.expense.result",
      "provider": "WECHAT",
      "sources": ["ACCESSIBILITY", "NOTIFICATION", "LOCAL_OCR", "ROOT_OCR"],
      "priority": 100,
      "package_names": ["com.tencent.mm"],
      "required_any_keywords": ["支付成功", "付款成功", "已支付", "成功付款", "扣款成功", "消费成功", "转账成功", "转账完成", "对方已收钱"],
      "excluded_keywords": ["支付失败", "付款失败", "交易关闭", "已取消", "查看账单详情"],
      "type": "EXPENSE",
      "fields": {
        "amount": [
          {"kind": "REGEX", "pattern": "(?m)^\\s*[-−﹣]\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)\\s*$", "group": 1, "normalizations": ["TRIM", "REMOVE_COMMAS"]},
          {"kind": "REGEX", "pattern": "(?:¥|￥|人民币|CNY\\s*)\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)", "group": 1, "normalizations": ["TRIM", "REMOVE_COMMAS"]},
          {"kind": "REGEX", "pattern": "([0-9][0-9,]*(?:\\.[0-9]{1,2})?)\\s*元", "group": 1, "normalizations": ["TRIM", "REMOVE_COMMAS"]}
        ],
        "merchant": [
          {"kind": "REGEX", "pattern": "(?m)^转账[-—－]?转给\\s*([^\\n]{1,80})\\s*$", "group": 1, "normalizations": ["TRIM"]},
          {"kind": "LABEL", "labels": ["商户", "收款方", "付款给", "收款人", "交易对象", "商品"]}
        ],
        "payment_method": [{"kind": "LABEL", "labels": ["付款方式", "支付方式", "扣款方式", "付款账户", "转出账户"]}],
        "external_key": [{"kind": "LABEL", "labels": ["交易单号", "订单号", "商户单号", "交易流水号", "转账单号"]}],
        "occurred_at": [{"kind": "LABEL", "labels": ["支付时间", "付款时间", "交易时间", "转账时间"]}],
        "currency": [{"kind": "CONSTANT", "value": "cny"}]
      }
    },
